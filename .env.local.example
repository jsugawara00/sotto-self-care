# ============================================================
#  Next.js アプリ用 環境変数テンプレート（雛形・GitHubに公開してOK）
#  ※ このファイルには実際の値を書かないこと。値は .env.local に入力する。
#  ※ NEXT_PUBLIC_ で始まる値はブラウザに公開されます（Firebaseの公開設定値はこれで問題なし）。
# ============================================================

# --- Firebase クライアント SDK（公開可・ブラウザで使用）---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin SDK（サーバー側のみ・絶対に公開しない）---
# Firebaseコンソール > プロジェクトの設定 > サービスアカウント で生成したJSONの値を .env.local 側に入れる。
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# 秘密鍵は \n を含む1行の文字列として、前後をダブルクオートで囲んで .env.local に貼る
FIREBASE_ADMIN_PRIVATE_KEY=

# --- Firebase エミュレータを使う場合（ローカルテスト用・任意）---
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false
